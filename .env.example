# Discord application credentials (Developer Portal -> your app)
DISCORD_TOKEN=
CLIENT_ID=

# Dev guild ID for fast (near-instant) guild-scoped slash command registration.
# Leave GUILD_ID set and DEPLOY_GLOBAL=false while developing.
GUILD_ID=
DEPLOY_GLOBAL=false

# SQLite database file path. Locally this can stay relative; on Railway point
# it at a mounted Volume, e.g. DATABASE_PATH=/data/erlc.sqlite
DATABASE_PATH=./data/erlc.sqlite

# One of: error, warn, info, debug
LOG_LEVEL=info
