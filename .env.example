# Discord application credentials (Developer Portal -> your app)
DISCORD_TOKEN=
CLIENT_ID=

# Dev guild ID for fast (near-instant) guild-scoped slash command registration.
# Leave GUILD_ID set and DEPLOY_GLOBAL=false while developing.
GUILD_ID=
DEPLOY_GLOBAL=false

# SQLite database file path. Locally this can stay relative; on Railway point
# it at a mounted Volume, e.g. DATABASE_PATH=/data/erlc.sqlite
DATABASE_PATH=./data/erlc.sqlite

# One of: error, warn, info, debug
LOG_LEVEL=info

# Rola nadawana automatycznie, gdy ktos pomyslnie zweryfikuje konto Roblox
# (panel /setup-roblox-panel). Puste = bot niczego nie nada.
VERIFIED_ROBLOX_ROLE_ID=

# Kanal, na ktory trafiaja utworzone dowody osobiste (Panel Obywatela -> Wyrob dowod).
# Puste = uzywany jest kanal ustawiony przez /config set-channel key:citizen_log_channel_id
# (a jesli i tego brak, kanal Panelu Obywatela).
CITIZEN_LOG_CHANNEL_ID=

# Kanaly "przyloty" (dolaczenie do serwera) i "odloty" (opuszczenie serwera).
# Puste = bot nie wysyla ogloszen dolaczenia/opuszczenia.
ARRIVALS_CHANNEL_ID=
DEPARTURES_CHANNEL_ID=
